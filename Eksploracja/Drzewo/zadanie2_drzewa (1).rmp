      <!-- 2. GENEROWANIE KOLUMN LOSOWYCH (rand, rand2) -->
      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Gen rand" width="90" x="195" y="34">
        <list key="function_descriptions">
          <parameter key="rand" value="rand()"/>
          <parameter key="rand2" value="rand()"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Europe/Warsaw"/>
      </operator>

      <!-- 3. GENEROWANIE ETYKIETY Z CZYSTYCH DANYCH (przed dodaniem szumu) -->
      <!-- click_label = 1 jesli adclick > 0 (reklama kliknieta), 0 jesli nie -->
      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Gen click_label" width="90" x="345" y="34">
        <list key="function_descriptions">
          <parameter key="click_label" value="if(adclick &gt; 0, 1, 0)"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Europe/Warsaw"/>
      </operator>

      <!-- 4. DODAWANIE BRAKUJACYCH WARTOSCI (5%) do cech, NIE do etykiety -->
      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Add missing" width="90" x="495" y="34">
        <list key="function_descriptions">
          <parameter key="adstart" value="if(rand &lt; 0.05, 0/0, adstart)"/>
          <parameter key="adfirst" value="if(rand &lt; 0.05, 0/0, adfirst)"/>
          <parameter key="admid" value="if(rand &lt; 0.05, 0/0, admid)"/>
          <parameter key="adthird" value="if(rand &lt; 0.05, 0/0, adthird)"/>
          <parameter key="adcomplete" value="if(rand &lt; 0.05, 0/0, adcomplete)"/>
          <parameter key="adpaused" value="if(rand &lt; 0.05, 0/0, adpaused)"/>
          <parameter key="adresume" value="if(rand &lt; 0.05, 0/0, adresume)"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Europe/Warsaw"/>
      </operator>

      <!-- 5. DODAWANIE OBSERWACJI ODSTAJACYCH (5%, mnoznik x10) -->
      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Add outliers" width="90" x="645" y="34">
        <list key="function_descriptions">
          <parameter key="adstart" value="if(rand2 &lt; 0.05, adstart*10, adstart)"/>
          <parameter key="adfirst" value="if(rand2 &lt; 0.05, adfirst*10, adfirst)"/>
          <parameter key="admid" value="if(rand2 &lt; 0.05, admid*10, admid)"/>
