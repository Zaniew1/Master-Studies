            <parameter key="minimal_size_for_split" value="4"/>
            <parameter key="number_of_prepruning_alternatives" value="3"/>
            <parameter key="random_splits" value="false"/>
            <parameter key="guess_subset_ratio" value="true"/>
            <parameter key="subset_ratio" value="0.2"/>
            <parameter key="voting_strategy" value="confidence vote"/>
            <parameter key="use_local_random_seed" value="false"/>
            <parameter key="local_random_seed" value="1992"/>
            <parameter key="enable_parallel_execution" value="true"/>
          </operator>
          <connect from_port="training set" to_op="Random Forest B2" to_port="training set"/>
          <connect from_op="Random Forest B2" from_port="model" to_port="model"/>
          <portSpacing port="source_training set" spacing="0"/>
          <portSpacing port="sink_model" spacing="0"/>
          <portSpacing port="sink_through 1" spacing="0"/>
        </process>
        <process expanded="true">
          <operator activated="true" class="apply_model" compatibility="12.1.001" expanded="true" height="82" name="Apply Model RF B2" width="90" x="112" y="238">
            <list key="application_parameters"/>
          </operator>
          <operator activated="true" class="performance" compatibility="12.1.001" expanded="true" height="82" name="Performance RF B2" width="90" x="313" y="238">
            <parameter key="use_example_weights" value="true"/>
          </operator>
          <connect from_port="model" to_op="Apply Model RF B2" to_port="model"/>
          <connect from_port="test set" to_op="Apply Model RF B2" to_port="unlabelled data"/>
          <connect from_op="Apply Model RF B2" from_port="labelled data" to_op="Performance RF B2" to_port="labelled data"/>
          <connect from_op="Performance RF B2" from_port="performance" to_port="performance 1"/>
          <portSpacing port="source_model" spacing="0"/>
          <portSpacing port="source_test set" spacing="0"/>
          <portSpacing port="source_through 1" spacing="0"/>
          <portSpacing port="sink_test set results" spacing="0"/>
          <portSpacing port="sink_performance 1" spacing="0"/>
          <portSpacing port="sink_performance 2" spacing="0"/>
        </process>
      </operator>

      <!-- ===== POLACZENIA ===== -->
      <connect from_op="Read CSV" from_port="output" to_op="Gen rand" to_port="table input"/>
      <connect from_op="Gen rand" from_port="table output" to_op="Gen click_label" to_port="table input"/>
      <connect from_op="Gen click_label" from_port="table output" to_op="Add missing" to_port="table input"/>
      <connect from_op="Add missing" from_port="table output" to_op="Add outliers" to_port="table input"/>
      <connect from_op="Add outliers" from_port="table output" to_op="Delete rand2" to_port="example set input"/>
      <connect from_op="Delete rand2" from_port="example set output" to_op="Delete rand" to_port="example set input"/>
      <connect from_op="Delete rand" from_port="example set output" to_op="Delete adclick" to_port="example set input"/>
      <connect from_op="Delete adclick" from_port="example set output" to_op="Multiply main" to_port="input"/>

      <!-- Galaz 1: Przed preprocessingiem -->
      <connect from_op="Multiply main" from_port="output 1" to_op="Replace Missing B1" to_port="example set input"/>
      <connect from_op="Replace Missing B1" from_port="example set output" to_op="Num to Poly B1" to_port="example set input"/>
      <connect from_op="Num to Poly B1" from_port="example set output" to_op="Set Role B1" to_port="example set input"/>
      <connect from_op="Set Role B1" from_port="example set output" to_op="Multiply B1" to_port="input"/>
      <connect from_op="Multiply B1" from_port="output 1" to_op="DT przed preprocessing" to_port="example set"/>
      <connect from_op="Multiply B1" from_port="output 2" to_op="RF przed preprocessing" to_port="example set"/>
      <connect from_op="DT przed preprocessing" from_port="performance 1" to_port="result 1"/>
      <connect from_op="RF przed preprocessing" from_port="performance 1" to_port="result 2"/>

      <!-- Galaz 2: Po preprocessingu -->
      <connect from_op="Multiply main" from_port="output 2" to_op="Replace Missing B2" to_port="example set input"/>
      <connect from_op="Replace Missing B2" from_port="example set output" to_op="Detect Outlier (Distances)" to_port="example set input"/>
      <connect from_op="Detect Outlier (Distances)" from_port="example set output" to_op="Filter Outliers" to_port="example set input"/>
      <connect from_op="Filter Outliers" from_port="example set output" to_op="Delete outlier col" to_port="example set input"/>
      <connect from_op="Delete outlier col" from_port="example set output" to_op="Num to Poly B2" to_port="example set input"/>
      <connect from_op="Num to Poly B2" from_port="example set output" to_op="Set Role B2" to_port="example set input"/>
      <connect from_op="Set Role B2" from_port="example set output" to_op="Normalize B2" to_port="example set input"/>
      <connect from_op="Normalize B2" from_port="example set output" to_op="Multiply B2" to_port="input"/>
      <connect from_op="Multiply B2" from_port="output 1" to_op="DT po preprocessingu" to_port="example set"/>
      <connect from_op="Multiply B2" from_port="output 2" to_op="RF po preprocessingu" to_port="example set"/>
      <connect from_op="DT po preprocessingu" from_port="performance 1" to_port="result 3"/>
      <connect from_op="RF po preprocessingu" from_port="performance 1" to_port="result 4"/>

      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <portSpacing port="sink_result 3" spacing="0"/>
      <portSpacing port="sink_result 4" spacing="0"/>
      <portSpacing port="sink_result 5" spacing="0"/>

      <description align="center" color="yellow" colored="true" height="60" resized="true" width="290" x="45" y="140">Wczytanie + etykieta (czyste dane) + szum 5% + outlier 5%x10</description>
      <description align="center" color="blue" colored="true" height="60" resized="true" width="600" x="1395" y="140">GA&#321;&#260;&#377; 1: PRZED PREPROCESSINGIEM &#8594; wynik 1: DT | wynik 2: RF</description>
      <description align="center" color="green" colored="true" height="60" resized="true" width="600" x="1395" y="610">GA&#321;&#260;&#377; 2: PO PREPROCESSINGU (outlier removed + Z-score) &#8594; wynik 3: DT | wynik 4: RF</description>

    </process>
  </operator>
</process>
